# Google Cloud Console > APIs & Services > Credentials > your OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match the redirect URI registered on that OAuth client
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Backend port, and where it should send the browser back to after auth
PORT=3001
FRONTEND_URL=http://localhost:5173

# Notion > your internal integration > Secrets. Starts with ntn_ or secret_.
# No OAuth needed for an internal integration — this token alone authenticates.
NOTION_API_KEY=

# The "Class Notes" database ID — from its Notion URL:
# notion.so/<workspace>/<DATABASE_ID>?v=... (32-char id, dashes optional)
NOTION_DATABASE_ID=
